# Copy this file to .env and set your local paths.
# .env is ignored by git. Docker Compose reads it automatically.

# Folder with the photos to classify (mounted as /photos)
PHOTOS_DIR=/path/to/photos

# Folder the classified photos go to (mounted as /classified)
CLASSIFIED_DIR=/path/to/classified

# Folder for photos.db (mounted as /db). Keep it outside synced folders
# such as Dropbox: syncing an SQLite file while it is written can corrupt it.
DB_DIR=/path/to/db
